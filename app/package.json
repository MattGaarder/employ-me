{
  "name": "employ-me",
  "version": "0.1.0",
  "description": "Personal job-search pipeline",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n \"scraper,app\" -c \"blue,magenta\" \"npm --prefix ../Linkedin-Jobs-Api run dev --workspace=backend\" \"npm run dev:server\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:scraper": "npm --prefix ../Linkedin-Jobs-Api run dev --workspace=backend",
    "dev:import": "concurrently -n \"scraper,app,import\" -c \"blue,magenta,cyan\" \"npm --prefix ../Linkedin-Jobs-Api run dev --workspace=backend\" \"npm run dev:server\" \"npm run wait:import\"",
    "wait:import": "tsx src/dev-import.ts",
    "import": "tsx src/run-imports.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test-notion": "tsx src/test-notion.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "ollama": "^0.6.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "concurrently": "^9.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
